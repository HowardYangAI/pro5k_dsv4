    {"type":"text","id":"before_code_t","x":110,"y":450,"width":640,"height":320,"text":"grid = (N_pages * RATIO,)\n\npid      = tl.program_id(0)\npage_idx = pid // RATIO\nsub      = pid % RATIO\n\nsrc_base = src + page_idx * src_stride\ndst_base = dst + (page_idx*RATIO+sub) * dst_stride\n\ncopy_data(src_base, dst_base)\ncopy_scale(src_base, dst_base)","originalText":"grid = (N_pages * RATIO,)\n\npid      = tl.program_id(0)\npage_idx = pid // RATIO\nsub      = pid % RATIO\n\nsrc_base = src + page_idx * src_stride\ndst_base = dst + (page_idx*RATIO+sub) * dst_stride\n\ncopy_data(src_base, dst_base)\ncopy_scale(src_base, dst_base)","fontSize":19,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#ffffff","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":302007,"version":1,"versionNonce":302008,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.35},
