    {"type":"text","id":"after_code_white","x":955,"y":448,"width":855,"height":225,"text":"# 1. 先生成 touched-page mask\nidx  = tl.load(indices + pid)\npage = idx // SRC_PBS\ntl.store(mask_ptr + page, 1)\n\n# 2. Page Split：Grid 仍然是 (N_pages * RATIO,)\npid      = tl.program_id(0)\npage_idx = pid // RATIO\nsub      = pid % RATIO","originalText":"# 1. 先生成 touched-page mask\nidx  = tl.load(indices + pid)\npage = idx // SRC_PBS\ntl.store(mask_ptr + page, 1)\n\n# 2. Page Split：Grid 仍然是 (N_pages * RATIO,)\npid      = tl.program_id(0)\npage_idx = pid // RATIO\nsub      = pid % RATIO","fontSize":17,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#ffffff","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":302019,"version":1,"versionNonce":302020,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.3},
